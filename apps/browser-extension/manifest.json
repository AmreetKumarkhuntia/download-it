{
  "manifest_version": 3,
  "name": "Download It — Development",
  "version": "0.1.0",
  "description": "Send direct file links to Download It, with optional automatic capture.",
  "minimum_chrome_version": "120",
  "permissions": ["nativeMessaging", "contextMenus", "storage", "alarms", "notifications"],
  "optional_permissions": ["downloads", "webRequest"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Download It" },
  "icons": { "128": "icon.png" },
  "incognito": "not_allowed"
}
