{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Download It",
  "version": "0.1.0",
  "identifier": "io.github.amreetkumarkhuntia.downloadit",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "Download It", "width": 1180, "height": 780, "minWidth": 780, "minHeight": 580 }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/aria2c"],
    "resources": {
      "binaries/aria2-libs/": "aria2-libs/",
      "binaries/manifest.json": "aria2-manifest.json",
      "../../../licenses/": "licenses/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "A local download manager powered by aria2",
    "category": "Utility"
  }
}
